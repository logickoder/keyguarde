<?xml version="1.0" encoding="utf-8"?>
<!-- Keyguarde launcher background: deep teal-black, with a soft teal glow behind the bubble. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
                <gradient android:type="linear" android:startX="0" android:startY="0" android:endX="108" android:endY="108">
                    <item android:offset="0" android:color="#FF173B38" />
                    <item android:offset="0.55" android:color="#FF0D2220" />
                    <item android:offset="1" android:color="#FF070F0E" />
                </gradient>
            </aapt:attr>
    </path>
    <!-- A circle the size of the glow: vector radial gradients repaint their edge colour past the
         radius, which drew a hard ring when this filled the whole square. -->
    <path android:pathData="M54,50m-46,0a46,46 0,1 1,92 0a46,46 0,1 1,-92 0">
        <aapt:attr name="android:fillColor">
                <gradient android:type="radial" android:centerX="54" android:centerY="50" android:gradientRadius="46">
                    <item android:offset="0" android:color="#8C2DD4BF" />
                    <item android:offset="0.6" android:color="#1F2DD4BF" />
                    <item android:offset="1" android:color="#002DD4BF" />
                </gradient>
            </aapt:attr>
    </path>
</vector>
