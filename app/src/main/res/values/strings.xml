    <!-- Help -->
    <string name="help_questions">Questions</string>
    <string name="help_contact">Get in touch</string>
    <string name="faq_notification_access_q">Why does Keyguarde need notification access?</string>
    <string name="faq_notification_access_a">It checks each new notification for your keywords. Without access, Android doesn\'t show it any.</string>
    <string name="faq_reads_messages_q">Does it read my messages?</string>
    <string name="faq_reads_messages_a">Only the text of notifications from the apps you pick, as they arrive. It can\'t open your chats, see older messages or read media.</string>
    <string name="faq_battery_q">Will it drain my battery?</string>
    <string name="faq_battery_a">No. It does nothing between notifications, and each check is a short text search.</string>
    <string name="faq_no_matches_q">Why am I not getting matches?</string>
    <string name="faq_no_matches_a">Go back to Settings and tap Run a test. If the test fails, turn Keyguarde\'s notification access off, then on. Also check the app is ticked under Apps, and Battery use says Unrestricted.</string>
    <string name="faq_manage_keywords_q">How do I add or remove keywords?</string>
    <string name="faq_manage_keywords_a">Open the Keywords tab. Tap + to add one. Each keyword has its own edit and delete buttons.</string>
    <string name="faq_select_apps_q">Can I pick which apps it watches?</string>
    <string name="faq_select_apps_a">Yes. Open Settings, then Apps. Chat apps on your phone are listed first.</string>
    <string name="faq_privacy_q">Where does my data go?</string>
    <string name="faq_privacy_a">Messages, matches and keywords stay on this phone. Keyguarde sends usage stats, crash reports and performance data to Google Firebase, and shows Google AdMob ads. Settings, then Privacy, lists exactly what.</string>
    <string name="faq_matching_q">How do matches work?</string>
    <string name="faq_matching_a">Whole words, any case. “rent” matches “Rent due” but not “current”. One message can match several keywords.</string>
